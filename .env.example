# Port to run the unified watch party server
PORT=4000

# Environment mode (development / production)
NODE_ENV=development

# Allowed CORS Origins (comma-separated or * for all)
CLIENT_ORIGIN=*

# Path to SQLite database file
DB_PATH=./watch_party.db

# Default video to display when creating a room
DEFAULT_VIDEO_ID=jfKfPfyJRdk

# Optional Redis Pub/Sub URL for multi-server horizontal scaling
# REDIS_URL=redis://default:password@redis-server:6379
